# Environment Variables for Supabase + Vercel

PORT=4000

# JWT Secret - use the existing one or generate a new one
JWT_SECRET=your_jwt_secret_here

# Supabase Database URLs (same names the Vercel Supabase integration sets)
# Get from: Supabase Dashboard > Connect > ORMs > Prisma
# Local Postgres works too: use the same URL for both.
POSTGRES_PRISMA_URL="postgresql://postgres.YOUR_PROJECT_ID:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgresql://postgres.YOUR_PROJECT_ID:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# On Vercel these come from the Supabase integration; set JWT_SECRET yourself.
